---
interface Props {
	title?: string;
}

const { title = 'GeniusHydra' } = Astro.props;
---

<!doctype html>
<html lang="en">
	<head>
		<meta charset="UTF-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1.0" />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<link rel="icon" href="/favicon.ico" />
		<meta name="description" content="GeniusHydra - Find me on Discord, Telegram, Steam and more." />
		<meta property="og:title" content={title} />
		<meta property="og:description" content="GeniusHydra - Find me on Discord, Telegram, Steam and more." />
		<meta property="og:type" content="website" />
		<meta property="og:url" content="https://geniushydra.com" />
		<title>{title}</title>
	</head>
	<body>
		<slot />
	</body>
</html>

<style is:global>
	@import url('https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&display=swap');

	*,
	*::before,
	*::after {
		box-sizing: border-box;
		margin: 0;
		padding: 0;
	}

	html {
		font-family: 'Inter', system-ui, -apple-system, sans-serif;
		-webkit-font-smoothing: antialiased;
		-moz-osx-font-smoothing: grayscale;
	}

	body {
		min-height: 100vh;
		background: #fafafa;
		color: #1a1a1a;
	}
</style>
