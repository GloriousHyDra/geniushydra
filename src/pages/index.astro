		</symbol>
		<symbol id="icon-telegram" viewBox="0 0 24 24" fill="currentColor">
			<path d="M11.944 0A12 12 0 000 12a12 12 0 0012 12 12 12 0 0012-12A12 12 0 0012 0zm4.962 7.224c.1-.002.321.023.465.14a.506.506 0 01.171.325c.016.093.036.306.02.472-.18 1.898-.962 6.502-1.36 8.627-.168.9-.499 1.201-.82 1.23-.696.065-1.225-.46-1.9-.902-1.056-.693-1.653-1.124-2.678-1.8-1.185-.78-.417-1.21.258-1.91.177-.184 3.247-2.977 3.307-3.23.007-.032.014-.15-.056-.212s-.174-.041-.249-.024c-.106.024-1.793 1.14-5.061 3.345-.479.33-.913.49-1.302.48-.428-.008-1.252-.241-1.865-.44-.752-.245-1.349-.374-1.297-.789.027-.216.325-.437.893-.663 3.498-1.524 5.83-2.529 6.998-3.014 3.332-1.386 4.025-1.627 4.476-1.635z"/>
		</symbol>
		<symbol id="icon-steam" viewBox="0 0 24 24" fill="currentColor">
			<path d="M11.979 0C5.678 0 .511 4.86.022 11.037l6.432 2.658c.545-.371 1.203-.59 1.912-.59.063 0 .125.004.188.006l2.861-4.142V8.91c0-2.495 2.028-4.524 4.524-4.524 2.494 0 4.524 2.031 4.524 4.527s-2.03 4.525-4.524 4.525h-.105l-4.076 2.911c0 .052.004.105.004.159 0 1.875-1.515 3.396-3.39 3.396-1.635 0-3.016-1.173-3.331-2.727L.436 15.27C1.862 20.307 6.486 24 11.979 24c6.627 0 11.999-5.373 11.999-12S18.605 0 11.979 0zM7.54 18.21l-1.473-.61c.262.543.714.999 1.314 1.25 1.297.539 2.793-.076 3.332-1.375.263-.63.264-1.319.005-1.949s-.75-1.121-1.377-1.383c-.624-.26-1.29-.249-1.878-.03l1.523.63c.956.4 1.409 1.5 1.009 2.455-.397.957-1.497 1.41-2.454 1.012zm11.415-9.303a3.015 3.015 0 00-3.015-3.015 3.015 3.015 0 103.015 3.015z"/>
		</symbol>
		<symbol id="icon-github" viewBox="0 0 24 24" fill="currentColor">
			<path d="M12 .297c-6.63 0-12 5.373-12 12 0 5.303 3.438 9.8 8.205 11.385.6.113.82-.258.82-.577 0-.285-.01-1.04-.015-2.04-3.338.724-4.042-1.61-4.042-1.61C4.422 18.07 3.633 17.7 3.633 17.7c-1.087-.744.084-.729.084-.729 1.205.084 1.838 1.236 1.838 1.236 1.07 1.835 2.809 1.305 3.495.998.108-.776.417-1.305.76-1.605-2.665-.3-5.466-1.332-5.466-5.93 0-1.31.465-2.38 1.235-3.22-.135-.303-.54-1.523.105-3.176 0 0 1.005-.322 3.3 1.23.96-.267 1.98-.399 3-.405 1.02.006 2.04.138 3 .405 2.28-1.552 3.285-1.23 3.285-1.23.645 1.653.24 2.873.12 3.176.765.84 1.23 1.91 1.23 3.22 0 4.61-2.805 5.625-5.475 5.92.42.36.81 1.096.81 2.22 0 1.606-.015 2.896-.015 3.286 0 .315.21.69.825.57C20.565 22.092 24 17.592 24 12.297c0-6.627-5.373-12-12-12"/>
		</symbol>
	</svg>
</Layout>

<style>
	main {
		display: flex;
		justify-content: center;
		align-items: center;
		min-height: 100vh;
		padding: 2rem 1rem;
		position: relative;
		overflow: hidden;
	}

	/* Soft colorful background glows */
	.glow {
		position: fixed;
		border-radius: 50%;
		filter: blur(100px);
		opacity: 0.4;
		pointer-events: none;
		z-index: 0;
	}

	.glow-1 {
		width: 500px;
		height: 500px;
		background: linear-gradient(135deg, #a78bfa, #818cf8);
		top: -150px;
		right: -100px;
		animation: float 8s ease-in-out infinite;
	}

	.glow-2 {
		width: 400px;
		height: 400px;
		background: linear-gradient(135deg, #38bdf8, #34d399);
		bottom: -100px;
		left: -100px;
		animation: float 8s ease-in-out infinite reverse;
	}

	@keyframes float {
		0%, 100% { transform: translate(0, 0); }
		50% { transform: translate(30px, -30px); }
	}

	.container {
		max-width: 440px;
		width: 100%;
		text-align: center;
		position: relative;
		z-index: 1;
	}

	.avatar {
		width: 100px;
		height: 100px;
		border-radius: 50%;
		background: linear-gradient(135deg, #667eea 0%, #764ba2 50%, #f093fb 100%);
		display: flex;
		align-items: center;
		justify-content: center;
		margin: 0 auto 1.5rem;
		box-shadow:
			0 4px 24px rgba(102, 126, 234, 0.35),
			0 0 0 4px rgba(255, 255, 255, 0.8);
		animation: pulse-glow 3s ease-in-out infinite;
	}

	@keyframes pulse-glow {
		0%, 100% { box-shadow: 0 4px 24px rgba(102, 126, 234, 0.35), 0 0 0 4px rgba(255, 255, 255, 0.8); }
		50% { box-shadow: 0 4px 32px rgba(118, 75, 162, 0.5), 0 0 0 4px rgba(255, 255, 255, 0.9); }
	}

	.avatar-text {
		font-size: 2.5rem;
		font-weight: 700;
		color: white;
		text-shadow: 0 2px 8px rgba(0, 0, 0, 0.15);
	}

	h1 {
		font-size: 1.85rem;
		font-weight: 700;
		color: #1a1a1a;
		margin-bottom: 0.25rem;
		letter-spacing: -0.02em;
	}

	.tagline {
		color: #888;
		font-size: 0.95rem;
		margin-bottom: 2rem;
	}

	.links {
		display: flex;
		flex-direction: column;
		gap: 0.625rem;
	}

	.link-card {
		display: flex;
		align-items: center;
		gap: 0.875rem;
		padding: 0.8rem 1.15rem;
		background: rgba(255, 255, 255, 0.85);
		backdrop-filter: blur(12px);
		-webkit-backdrop-filter: blur(12px);
		border: 1px solid rgba(0, 0, 0, 0.06);
		border-radius: 14px;
		text-decoration: none;
		color: #1a1a1a;
		transition: all 0.25s ease;
	}

	.link-card:hover {
		background: rgba(255, 255, 255, 0.95);
		border-color: var(--accent);
		box-shadow: 0 4px 20px rgba(0, 0, 0, 0.08);
		transform: translateY(-2px);
	}

	.link-card:hover .link-icon-wrap {
		background: var(--gradient);
	}

	.link-card:hover .link-icon {
		color: white;
	}

	.link-icon-wrap {
		width: 38px;
		height: 38px;
		border-radius: 10px;
		background: #f0f0f0;
		display: flex;
		align-items: center;
		justify-content: center;
		flex-shrink: 0;
		transition: background 0.25s ease;
	}

	.link-icon {
		width: 20px;
		height: 20px;
		color: #555;
		transition: color 0.25s ease;
	}

	.link-text {
		flex: 1;
		text-align: left;
		display: flex !important;
		flex-direction: column !important;
		gap: 2px;
	}

	.link-name {
		font-weight: 600;
		font-size: 0.9rem;
		line-height: 1.2;
	}

	.link-subtitle {
		font-size: 0.75rem;
		color: #999;
		font-weight: 400;
	}

	.arrow {
		width: 18px;
		height: 18px;
		color: #ccc;
		flex-shrink: 0;
		transition: all 0.25s ease;
	}

	.link-card:hover .arrow {
		transform: translateX(3px);
		color: var(--accent);
	}

	footer {
		margin-top: 3rem;
		color: #bbb;
		font-size: 0.8rem;
	}
</style>
