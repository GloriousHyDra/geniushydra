---
import Layout from '../layouts/Layout.astro';

interface LinkItem {
	name: string;
	subtitle?: string;
	url: string;
	icon: string;
	color: string;
	gradient?: string;
}

const links: LinkItem[] = [
	{
		name: 'Discord',
		subtitle: 'My personal account',
		url: 'https://discord.com/users/geniushydra',
		icon: 'discord',
		color: '#5865F2',
		gradient: 'linear-gradient(135deg, #5865F2, #7289DA)',
	},
	{
		name: 'Discord Server',
		subtitle: 'My discord server',
		url: 'https://discord.gg/mq5Tv7Q',
		icon: 'discord',
		color: '#5865F2',
		gradient: 'linear-gradient(135deg, #7289DA, #99AAF5)',
	},
	{
		name: 'Telegram',
		subtitle: 'Message me',
		url: 'https://t.me/geniushydra',
		icon: 'telegram',
		color: '#26A5E4',
		gradient: 'linear-gradient(135deg, #0088CC, #26A5E4)',
	},
	{
		name: 'Telegram Channel',
		subtitle: 'My telegram channel',
		url: 'https://t.me/hydrachillhouse',
		icon: 'telegram',
		color: '#26A5E4',
		gradient: 'linear-gradient(135deg, #26A5E4, #6DD5FA)',
	},
	{
		name: 'Steam',
		subtitle: 'Play with me',
		url: 'https://steamcommunity.com/id/geniushydra/',
		icon: 'steam',
		color: '#1B2838',
		gradient: 'linear-gradient(135deg, #1B2838, #2A475E)',
	},
	{
		name: 'GitHub',
		subtitle: 'My projects',
		url: 'https://github.com/GloriousHyDra',
		icon: 'github',
		color: '#24292e',
		gradient: 'linear-gradient(135deg, #24292e, #555)',
	},
];
---

<Layout>
	<main>
		<div class="glow glow-1"></div>
		<div class="glow glow-2"></div>

		<div class="container">
			<div class="avatar">
				<span class="avatar-text">G</span>
			</div>
			<h1>GeniusHydra</h1>
			<p class="tagline">Find me on the internet</p>

			<div class="links">
				{links.map((link) => (
					<a
						href={link.url}
						target="_blank"
						rel="noopener noreferrer"
						class="link-card"
						style={`--accent: ${link.color}; --gradient: ${link.gradient}`}
					>
						<div class="link-icon-wrap">
							<svg class="link-icon">
								<use href={`#icon-${link.icon}`} />
							</svg>
						</div>
						<div class="link-text">
							<span class="link-name">{link.name}</span>
							{link.subtitle && <span class="link-subtitle">{link.subtitle}</span>}
						</div>
						<svg class="arrow" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
							<path d="M5 12h14M12 5l7 7-7 7" />
						</svg>
					</a>
				))}
			</div>

			<footer>
				<p>&copy; {new Date().getFullYear()} GeniusHydra</p>
			</footer>
		</div>
	</main>

	<!-- SVG icon sprites -->
	<svg xmlns="http://www.w3.org/2000/svg" style="display: none;">
		<symbol id="icon-discord" viewBox="0 0 24 24" fill="currentColor">
